# The bare domain (no "www") had no site block at all, so Caddy had no
# certificate for it - a real, 100%-reproducible bug found 2026-08-13:
# anyone reaching https://broffice.bg directly (typed without www, an old
# bookmark/business card, etc.) got a hard TLS handshake failure ("tlsv1
# alert internal error"), confirmed directly with openssl. This gives it
# its own real certificate and redirects to the canonical www version,
# matching DJANGO_ALLOWED_HOSTS/FRONTEND_DOMAIN which already treat
# broffice.bg as a valid host, just not the canonical one.
broffice.bg {
	tls {
		key_type rsa2048
	}
	redir https://www.broffice.bg{uri} permanent
}

{$DOMAIN} {
	encode gzip

	# Caddy's default automatic HTTPS issues an ECDSA certificate, which
	# chains through Let's Encrypt's newer "ISRG Root X2" - not yet
	# trusted by every device (confirmed directly: worked in Chrome/
	# Android, failed on an iPhone and 2 of 5 test computers, all with the
	# exact same TLS handshake failure). rsa2048 chains through the
	# original "ISRG Root X1" instead, which is trusted essentially
	# universally, including by older devices.
	tls {
		key_type rsa2048
	}

	# Bare top-level directives in a Caddyfile do NOT run in the order
	# they're written — Caddy applies a fixed internal phase order instead
	# (try_files runs before reverse_proxy regardless of source order),
	# which silently rewrote every /api/, /robots.txt, /sitemap.xml request
	# to /index.html before the backend matcher ever got a chance (caught by
	# actually curling the running stack, not by inspection). `handle`/
	# `handle_path` blocks are the fix — they're mutually exclusive and
	# evaluated in write order, first match wins, like a switch statement.

	@backend path /api/* /django-admin/* /robots.txt /sitemap.xml /llms.txt

	# Static/media files are served directly off disk, not proxied through
	# gunicorn — the standard Django-in-production split. Volumes shared
	# with the backend container (see docker-compose.prod.yml): /srv/static
	# is collectstatic's output, /srv/media is Django's MEDIA_ROOT.
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Everything else Django actually owns — the API, the Django admin, and
	# the three SEO endpoints (backend/seo/views.py — real DB-backed views,
	# not static files, so these must reach Django).
	handle @backend {
		reverse_proxy backend:8000
	}

	# Everything else is the built React SPA. try_files falls back to
	# index.html for any path that isn't a real static file, so client-side
	# routes (react-router's /product/..., /category/..., etc.) work on a
	# hard refresh or a direct/shared link, not just in-app navigation.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
