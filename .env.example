# Django
# Generate a real value for production: python -c "from django.core.management.utils
# import get_random_secret_key; print(get_random_secret_key())" — the app refuses to
# start with DEBUG=False while this is still the placeholder dev default.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Real production origin(s), comma-separated, e.g. https://your-domain.bg —
# defaults below only cover local dev.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to True only once a real TLS certificate is live in front of the app —
# turning this on before HTTPS actually works breaks the site (redirect loop).
DJANGO_HTTPS_ENABLED=False

# Database
POSTGRES_DB=broffice
POSTGRES_USER=broffice
POSTGRES_PASSWORD=broffice_secret
# Empty = SQLite locally; use "postgres" inside Docker Compose, or "localhost" for local Postgres
POSTGRES_HOST=
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email (configure for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@broffice.local
ADMIN_ORDER_EMAIL=admin@broffice.local

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supplier catalog sync (server-side only — never expose to the frontend)
SUPPLIER_CATALOG_API_KEY=
SUPPLIER_CATALOG_BASE_URL=https://officecenter-bg.com/api/client-integration

# Paths
# Leave empty to use the computed default (../officecenter-bg.com next to this
# project, resolved as an absolute path regardless of process CWD).
HTTRACK_ROOT=
MEDIA_ROOT=/app/media
