# Django
# Generate a real value for production: python -c "from django.core.management.utils
# import get_random_secret_key; print(get_random_secret_key())" — the app refuses to
# start with DEBUG=False while this is still the placeholder dev default.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Real production origin(s), comma-separated, e.g. https://your-domain.bg —
# defaults below only cover local dev.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to True only once a real TLS certificate is live in front of the app —
# turning this on before HTTPS actually works breaks the site (redirect loop).
DJANGO_HTTPS_ENABLED=False

# --- Production values (docker-compose.prod.yml / docs/DEPLOYMENT.md) ---
# Everything above this line needs a real value when actually deploying:
#   DJANGO_SECRET_KEY=<real generated value>
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=broffice.bg,www.broffice.bg
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://broffice.bg,https://www.broffice.bg
#   DJANGO_HTTPS_ENABLED=True
#   FRONTEND_BASE_URL=https://www.broffice.bg
#   POSTGRES_PASSWORD=<real generated value, not the dev default below>
# DJANGO_CORS_ALLOWED_ORIGINS doesn't need a production value at all — Caddy
# serves the frontend and API from the same origin, so no cross-origin
# requests happen in production.
# Caddy-only, not read by Django — the domain it requests a Let's Encrypt
# certificate for. Must match DJANGO_ALLOWED_HOSTS above.
FRONTEND_DOMAIN=www.broffice.bg

# Database
POSTGRES_DB=broffice
POSTGRES_USER=broffice
POSTGRES_PASSWORD=broffice_secret
# Empty = SQLite locally; use "postgres" inside Docker Compose, or "localhost" for local Postgres
POSTGRES_HOST=
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email (configure for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@broffice.local
ADMIN_ORDER_EMAIL=admin@broffice.local

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Used to build absolute URLs in emails, canonical tags, Open Graph tags,
# robots.txt, and sitemap.xml. Production value: https://www.broffice.bg
FRONTEND_BASE_URL=http://localhost:5173

# Supplier catalog sync (server-side only — never expose to the frontend)
SUPPLIER_CATALOG_API_KEY=
SUPPLIER_CATALOG_BASE_URL=https://officecenter-bg.com/api/client-integration

# Paths
# Leave empty to use the computed default (../officecenter-bg.com next to this
# project, resolved as an absolute path regardless of process CWD).
HTTRACK_ROOT=
MEDIA_ROOT=/app/media

# Database backups / restore (see scripts/backup-database.ps1,
# restore-watcher.ps1, and the "Резервни копия" admin page)
# Comma-separated usernames allowed to see/use the backup-restore admin page —
# deliberately never the client's own account, since a restore replaces
# whatever they currently have live.
DEVELOPER_USERNAMES=doanchetoidriz
# Read by the backend container to list/request-restore backups; must match
# the host path scripts/backup-database.ps1 and restore-watcher.ps1 write to
# (docker-compose.prod.yml mounts BACKUP_ROOT_HOST here as /backups).
BACKUP_ROOT=/backups
# Host-side path for the same folder — set in the deploy machine's real .env,
# not this template. Default if unset: C:/broffice-backups
BACKUP_ROOT_HOST=C:/broffice-backups
